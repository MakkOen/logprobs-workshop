tem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Fine-tuning","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"QXCzINqiUJ"}],"key":"mFhyUIhN2h"},{"type":"text","value":" — adapts the model’s weights directly to your task, improving both accuracy and confidence quality","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"nHo4Tfqzgx"}],"key":"jTJng6B9uU"}],"key":"DCfrwJA0d6"}],"key":"kviB8Cp3Yq"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"These techniques complement, not replace","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"KQXPjZELhY"}],"key":"ADWRBp4qyF"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"None of these are alternatives to logprob-based confidence scoring: they make it work better. A well-prompted or fine-tuned model produces sharper probability distributions, which means cleaner signals and better downstream classification.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"zPjcz71a2W"}],"key":"do3GXZZLu5"}],"class":"tip","key":"cinalQalay"}],"key":"IKDNyo24VN"}],"key":"cd8199WuTP"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Putting It All Together","url":"/combining","group":"Hallucination Detection"}}},"domain":"http://localhost:3000"}