{"version":3,"kind":"Article","sha256":"ddf5fc9d9e147de032ed5733fb204cf67adfb01bcd74605b1a429aa3608f16b6","slug":"outro","location":"/chapters/05/outro.md","dependencies":[],"frontmatter":{"title":"Outro","content_includes_title":false,"github":"https://github.com/MakkOen/logprobs-workshop","copyright":"2025","numbering":{"title":{"offset":1}},"source_url":"https://github.com/MakkOen/logprobs-workshop/blob/main/chapters/05/outro.md","edit_url":"https://github.com/MakkOen/logprobs-workshop/edit/main/chapters/05/outro.md","exports":[{"format":"md","filename":"outro.md","url":"/logprobs-workshop/build/outro-b0fe971340367ed2ed0671ddbd8ad400.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"What we covered","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DvnahKjKcu"}],"identifier":"what-we-covered","label":"What we covered","html_id":"what-we-covered","implicit":true,"key":"rPsNDv88Cr"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We are used to treating LLM as black-boxes. And praying to them when they don’t give us what they want. In this workshop we have shown, on real usecase and data, that we don’t need to abandon our agency when using LLMs and we can go back to our ML roots and create proper models with them:","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"EN5YrTtSRn"}],"key":"A63ZUXhUMD"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Binary classification","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"YtFE8HAiWi"}],"key":"pqmMxYsWsn"},{"type":"text","value":" — instead of parsing yes/no text, we read the token probability directly as a continuous confidence score and tuned the threshold to hit our precision/recall target","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"MUCjLxWQ0Z"}],"key":"AJsdCwmKDd"}],"key":"LtFu8T2QnO"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Hallucination detection","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"A4hXx5r4JG"}],"key":"LfsWIkQNFd"},{"type":"text","value":" — we combined three independent signals (logprob confidence, embedding similarity, LLM judge) and used Optuna to find the optimal thresholds across all six features","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Vb42GkFunn"}],"key":"xMBOy0F4qZ"}],"key":"V9KyGLu1Pt"}],"key":"fVzhC164Dh"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"The core idea throughout: logprobs let you treat an LLM output as a probability distribution, not just a string. That’s the bridge back to classical ML.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"EhAIVxUJHd"}],"key":"OKASzh5Fbw"},{"type":"thematicBreak","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"ziqb75BgEl"},{"type":"heading","depth":2,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"A note on simplification","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"Y1lzfEJYrF"}],"iden