{"version":3,"kind":"Article","sha256":"0354b9af3f0e44ec51c83af176f62963406784da9c58f53876b6e02e6c20370a","slug":"classification","location":"/chapters/03/classification.md","dependencies":[],"frontmatter":{"title":"Use Case: Classification using LLM","content_includes_title":false,"github":"https://github.com/MakkOen/logprobs-workshop","copyright":"2025","numbering":{"title":{"offset":1}},"source_url":"https://github.com/MakkOen/logprobs-workshop/blob/main/chapters/03/classification.md","edit_url":"https://github.com/MakkOen/logprobs-workshop/edit/main/chapters/03/classification.md","exports":[{"format":"md","filename":"classification.md","url":"/logprobs-workshop/build/classification-d4c8cd2b430bfc3b2791cfd683084bdf.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We prompt the model to output exactly one token (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"D0QATvzL1P"},{"type":"inlineCode","value":"incident","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OtBq9P8S3k"},{"type":"text","value":" or ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZXfbeaFo9S"},{"type":"inlineCode","value":"noise","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IgKzD6yeGS"},{"type":"text","value":") and read the logprob of that token as our confidence score.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ibGsCBxTyC"}],"key":"EoNzjT3J0B"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Single prediction","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"JJTVfPb48E"}],"identifier":"single-prediction","label":"Single prediction","html_id":"single-prediction","implicit":true,"key":"fOullrmVOk"},{"type":"code","lang":"python","value":"INSTRUCTIONS = \"\"\"Given a police/firefighter/EMS radio transcript, decide whether the transcript is about an incident happening or just noise.\nAn incident must contain:\n* what is happening\n* address where it's happening.\nOutput only 'incident' or 'noise'.\n\"\"\"\n\nresponse = client.responses.create(\n    model=\"gpt-4o-mini\",\n    input=[\n        {\"role\": \"system\", \"content\": INSTRUCTIONS},\n        {\"role\": \"user\", \"content\": df.iloc[0].transcription},\n    ],\n    top_logprobs=2,\n    include=[\"message.output_text.logprobs\"],\n)","position":{"start":{"line":7,"column":1},"end":{"line":24,"column":1}},"key":"xfDvHwTpAX"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"The predicted token and its probability:","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"TTYjiDuxTo"}],"key":"BubRBdKq0s"},{"type":"code","lang":"python","value":"response.output[0].content[0].logprobs[0].top_logprobs[0].token\nmath.exp(response.output[0].content[0].logprobs[0].top_logprobs[0].logprob)","position":{"start":{"line":28,"column":1},"end":{"line":31,"column":1}},"key":"TIx6RgzpyF"},{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Run over the full dataset","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ThoF2ZRglu"}],"identifier":"run-over-the-full-dataset","label":"Run over the full dataset","html_id":"run-over-the-full-dataset","implicit":true,"key":"oaulNqcavF"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"We sum up the probability mass on the ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"F5ti6oGGKn"},{"type":"inlineCode","value":"incident","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"itREMQgNKX"},{"type":"text","value":" token across the top logprobs. This handles cases where the model outputs ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"GGPjEilLXN"},{"type":"inlineCode","value":"Incident","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"uwLsTDNy8M"},{"type":"text","value":" (capitalised) or other variants:","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"rDmzSMnpga"}],"key":"uOw7BXSN7N"},{"type":"code","lang":"python","value":"output_token = []\noutput_prob = []\n\nfor _, row in tqdm(df.iterrows(), total=df.shape[0]):\n    response = client.responses.create(\n        model=\"gpt-4o-mini\",\n        input=[\n            {\"role\": \"system\", \"content\": INSTRUCTIONS},\n            {\"role\": \"user\", \"content\": row.transcription},\n        ],\n        top_logprobs=4,\n        include=[\"message.output_text.logprobs\"],\n    )\n    output_token.append(response.output_text)\n    prob = 0.0\n    for top_logprob in response.output[0].content[0].logprobs[0].top_logprobs:\n        if top_logprob.token.lower() == \"incident\":\n            prob += math.exp(top_logprob.logprob)\n    output_prob.append(prob)\n\ndf[\"output_token\"] = output_token\ndf[\"output_prob\"] = output_prob","position":{"start":{"line":37,"column":1},"end":{"line":60,"column":1}},"key":"dux3a2aWLF"}],"key":"SqnB2ZeUDj"}],"key":"KjJUm6ZVLU"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Data","url":"/data","group":"Binary Classification"},"next":{"title":"Threshold Tuning","url":"/threshold-tuning","group":"Binary Classification"}}},"domain":"http://localhost:3000"}