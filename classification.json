{"version":3,"kind":"Article","sha256":"0354b9af3f0e44ec51c83af176f62963406784da9c58f53876b6e02e6c20370a","slug":"classification","location":"/chapters/03/classification.md","dependencies":[],"frontmatter":{"title":"Use Case: Classification using LLM","content_includes_title":false,"github":"https://github.com/MakkOen/logprobs-workshop","copyright":"2025","numbering":{"title":{"offset":1}},"source_url":"https://github.com/MakkOen/logprobs-workshop/blob/main/chapters/03/classification.md","edit_url":"https://github.com/MakkOen/logprobs-workshop/edit/main/chapters/03/classification.md","exports":[{"format":"md","filename":"classification.md","url":"/logprobs-workshop/build/classification-e3c6f103e47f3d2184628c1470787df3.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We prompt the model to output exactly one token (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ljGcBR9thI"},{"type":"inlineCode","value":"incident","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zMgxdFN35J"},{"type":"text","value":" or ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ureZWxFbHJ"},{"type":"inlineCode","value":"noise","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"d4NS98QPfb"},{"type":"text","value":") and read the logprob of that token as our confidence score.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YZsbSZ6sGP"}],"key":"GNxm5Xb2UQ"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Single prediction","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CGJCa2j3BJ"}],"identifier":"single-prediction","label":"Single prediction","html_id":"single-prediction","implicit":true,"key":"SOvLqjWX5A"},{"type":"code","lang":"python","value":"INSTRUCTIONS = \"\"\"Given a police/firefighter/EMS radio transcript, decide whether the transcript is about an incident happening or just noise.\nAn incident must contain:\n* what is happening\n* address where it's happening.\nOutput only 'incident' or 'noise'.\n\"\"\"\n\nresponse = client.responses.create(\n    model=\"gpt-4o-mini\",\n    input=[\n        {\"role\": \"system\", \"content\": INSTRUCTIONS},\n        {\"role\": \"user\", \"content\": df.iloc[0].transcription},\n    ],\n    top_logprobs=2,\n    include=[\"message.output_text.logprobs\"],\n)","position":{"start":{"line":7,"column":1},"end":{"line":24,"column":1}},"key":"rTyWTXg7Hf"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"The predicted token and its probability:","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"nVOTHpxOZ7"}],"key":"A0hf3t3X46"},{"type":"code","lang":"python","value":"response.output[0].content[0].logprobs[0].top_logprobs[0].token\nmath.exp(response.output[0].content[0].logprobs[0].top_logprobs[0].logprob)","position":{"start":{"line":28,"column":1},"end":{"line":31,"column":1}},"key":"z3yOOd9M5l"},{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Run over the full dataset","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"MEQjk6Ozmn"}],"identifier":"run-over-the-full-dataset","label":"Run over the full dataset","html_id":"run-over-the-full-dataset","implicit":true,"key":"L2QXyiivVg"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"We sum up the probability mass on the ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"XLsjcK3uoM"},{"type":"inlineCode","value":"incident","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"oidBfkfRQC"},{"type":"text","value":" token across the top logprobs. This handles cases where the model outputs ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"lGJkDRLBcp"},{"type":"inlineCode","value":"Incident","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"giqQ7HaNZq"},{"type":"text","value":" (capitalised) or other variants:","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"pfZTxe1Lb8"}],"key":"uBt7nk201Z"},{"type":"code","lang":"python","value":"output_token = []\noutput_prob = []\n\nfor _, row in tqdm(df.iterrows(), total=df.shape[0]):\n    response = client.responses.create(\n        model=\"gpt-4o-mini\",\n        input=[\n            {\"role\": \"system\", \"content\": INSTRUCTIONS},\n            {\"role\": \"user\", \"content\": row.transcription},\n        ],\n        top_logprobs=4,\n        include=[\"message.output_text.logprobs\"],\n    )\n    output_token.append(response.output_text)\n    prob = 0.0\n    for top_logprob in response.output[0].content[0].logprobs[0].top_logprobs:\n        if top_logprob.token.lower() == \"incident\":\n            prob += math.exp(top_logprob.logprob)\n    output_prob.append(prob)\n\ndf[\"output_token\"] = output_token\ndf[\"output_prob\"] = output_prob","position":{"start":{"line":37,"column":1},"end":{"line":60,"column":1}},"key":"DHc0R2jICx"}],"key":"Ry0TjQgESh"}],"key":"pEMsn0jo76"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Data","url":"/data","group":"Binary Classification"},"next":{"title":"Threshold Tuning","url":"/threshold-tuning","group":"Binary Classification"}}},"domain":"http://localhost:3000"}