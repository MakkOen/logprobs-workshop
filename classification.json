{"version":3,"kind":"Article","sha256":"a4fa17d631eab633674d039ce8e77e2cdd88e986ff7f8555cb813da1a6debf67","slug":"classification","location":"/chapters/03/classification.md","dependencies":[],"frontmatter":{"title":"Classification using LLM","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Luděk Matyska","given":"Luděk","family":"Matyska"},"name":"Luděk Matyska","affiliations":["ROUVY"],"id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Vojtech Kadlec","given":"Vojtech","family":"Kadlec"},"name":"Vojtech Kadlec","affiliations":["STRV"],"id":"contributors-myst-generated-uid-1"}],"github":"https://github.com/MakkOen/logprobs-workshop","copyright":"2025","affiliations":[{"id":"ROUVY","name":"ROUVY"},{"id":"STRV","name":"STRV"}],"numbering":{"title":{"offset":1}},"source_url":"https://github.com/MakkOen/logprobs-workshop/blob/main/chapters/03/classification.md","edit_url":"https://github.com/MakkOen/logprobs-workshop/edit/main/chapters/03/classification.md","exports":[{"format":"md","filename":"classification.md","url":"/logprobs-workshop/build/classification-69108406f0a643fa5cdcc9003cb8cd68.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We prompt the model to output exactly one token (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ui6XXqryCY"},{"type":"inlineCode","value":"incident","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QjhFfMRjWG"},{"type":"text","value":" or ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RQW0BBZlTZ"},{"type":"inlineCode","value":"noise","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nRdEhPoQK8"},{"type":"text","value":") and read the logprob of that token as our confidence score.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DjM9lGKr6G"}],"key":"g7VV9QYdoA"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Single prediction","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"TxUaOyxCvl"}],"identifier":"single-prediction","label":"Single prediction","html_id":"single-prediction","implicit":true,"key":"fMuZzglPnd"},{"type":"code","lang":"python","value":"INSTRUCTIONS = \"\"\"Given a police/firefighter/EMS radio transcript, decide whether the transcript is about an incident happening or just noise.\nAn incident must contain:\n* what is happening\n* address where it's happening.\nOutput only 'incident' or 'noise'.\n\"\"\"\n\nresponse = client.responses.create(\n    model=\"gpt-4o-mini\",\n    input=[\n        {\"role\": \"system\", \"content\": INSTRUCTIONS},\n        {\"role\": \"user\", \"content\": df.iloc[0].transcription},\n    ],\n    top_logprobs=2,\n    include=[\"message.output_text.logprobs\"],\n)","position":{"start":{"line":7,"column":1},"end":{"line":24,"column":1}},"key":"GvFUPR0CRB"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"The predicted token and its probability:","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ZRHdPN39Ew"}],"key":"U37XZarXoD"},{"type":"code","lang":"python","value":"response.output[0].content[0].logprobs[0].top_logprobs[0].token\nmath.exp(response.output[0].content[0].logprobs[0].top_logprobs[0].logprob)","position":{"start":{"line":28,"column":1},"end":{"line":31,"column":1}},"key":"WXUovQYxRy"},{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Run over the full dataset","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"AUfxmsmYic"}],"identifier":"run-over-the-full-dataset","label":"Run over the full dataset","html_id":"run-over-the-full-dataset","implicit":true,"key":"oR9PLpPNgq"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"We sum up the probability mass on the ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"hcciMx3fBg"},{"type":"inlineCode","value":"incident","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"hITiPtx3V6"},{"type":"text","value":" token across the top logprobs. This handles cases where the model outputs ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"jWN5npzVSC"},{"type":"inlineCode","value":"Incident","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"OMck4YHKn1"},{"type":"text","value":" (capitalised) or other variants:","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"WCjbejk07h"}],"key":"mhYkXxHQR3"},{"type":"code","lang":"python","value":"output_token = []\noutput_prob = []\n\nfor _, row in tqdm(df.iterrows(), total=df.shape[0]):\n    response = client.responses.create(\n        model=\"gpt-4o-mini\",\n        input=[\n            {\"role\": \"system\", \"content\": INSTRUCTIONS},\n            {\"role\": \"user\", \"content\": row.transcription},\n        ],\n        top_logprobs=4,\n        include=[\"message.output_text.logprobs\"],\n    )\n    output_token.append(response.output_text)\n    prob = 0.0\n    for top_logprob in response.output[0].content[0].logprobs[0].top_logprobs:\n        if top_logprob.token.lower() == \"incident\":\n            prob += math.exp(top_logprob.logprob)\n    output_prob.append(prob)\n\ndf[\"output_token\"] = output_token\ndf[\"output_prob\"] = output_prob","position":{"start":{"line":37,"column":1},"end":{"line":60,"column":1}},"key":"kQwwywd9ot"}],"key":"KkDTiFLmRh"}],"key":"lcnfMcuUpB"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{