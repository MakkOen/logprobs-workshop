{"version":3,"kind":"Article","sha256":"c939293341ecaebcf0d3c79a7226d9c21702fafee90d5838ee02600c52555a91","slug":"multi-token","location":"/chapters/02/multi_token.md","dependencies":[],"frontmatter":{"title":"Multi-token Response","content_includes_title":false,"github":"https://github.com/MakkOen/logprobs-workshop","copyright":"2025","numbering":{"title":{"offset":1}},"source_url":"https://github.com/MakkOen/logprobs-workshop/blob/main/chapters/02/multi_token.md","edit_url":"https://github.com/MakkOen/logprobs-workshop/edit/main/chapters/02/multi_token.md","exports":[{"format":"md","filename":"multi_token.md","url":"/logprobs-workshop/build/multi_token-543eba724475f8d26fbd2b0abfd8e9ae.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"For a response with multiple tokens, logprobs are returned for each position. The first token’s top alternatives:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SwhP7ft9p6"}],"key":"tZ2n9JQ7fU"},{"type":"code","lang":"python","value":"response = client.responses.create(\n    model=\"gpt-4o-mini\",\n    input=\"Hello from ML Prague\",\n    top_logprobs=2,\n    include=[\"message.output_text.logprobs\"],\n)\n\nsum = 0.0\nfor logprob in response.output[0].content[0].logprobs[0].top_logprobs:\n    print(f\"token: {logprob.token}, prob: {math.exp(logprob.logprob)}\")\n    sum += math.exp(logprob.logprob)\nprint(f\"total: {sum}\")","position":{"start":{"line":5,"column":1},"end":{"line":18,"column":1}},"key":"fw7oXz5yXc"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"To get the probability of the entire sequence, multiply the chosen token’s probability at each position (or equivalently, sum the log-probs and exponentiate):","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"LHHZkjwDZk"}],"key":"XaI8KEGcX5"},{"type":"code","lang":"python","value":"sum = 0.0\nfor logprob in response.output[0].content[0].logprobs:\n    print(f\"token: {logprob.top_logprobs[0].token}, prob: {math.exp(logprob.logprob)}\")\n    sum += logprob.logprob\n\nprint(math.exp(sum))","position":{"start":{"line":22,"column":1},"end":{"line":29,"column":1}},"key":"SitIfbv0jE"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Sequence probability drops quickly with length. Normalize by dividing the log-sum by the number of tokens:","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"Mcc8F1d568"}],"key":"Wm7uUZbRL7"},{"type":"code","lang":"python","value":"# Normalized\nmath.exp(sum / len(response.output[0].content[0].logprobs))","position":{"start":{"line":33,"column":1},"end":{"line":36,"column":1}},"key":"dXUNVJHFYv"}],"key":"UQhxoB6DuR"}],"key":"hqkAOHhFjH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Logprobs","url":"/logprobs-single-token","group":"Logprobs"},"next":{"title":"Reasoning Models","url":"/reasoning-models","group":"Logprobs"}}},"domain":"http://localhost:3000"}